{
  "name": "playwright-toolshop-e2e",
  "version": "1.0.0",
  "description": "Portfolio-quality Playwright end-to-end and API test suite for the Practice Software Testing Toolshop",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:chromium": "playwright test --project=chromium",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "report": "playwright show-report",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.1",
    "eslint-plugin-playwright": "^2.11.0"
  }
}
